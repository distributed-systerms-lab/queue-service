# Local lab credentials only. Use URI-safe passwords (for example: openssl rand -hex 24).
RABBITMQ_USER=lab
RABBITMQ_PASSWORD=replace-with-a-random-hex-password
POSTGRES_PASSWORD=replace-with-another-random-hex-password

# Use the name of an existing shared Docker network.
LAB_NETWORK=lab-messaging
QUEUES=tasks
QUEUE_NAME=tasks
CONCURRENCY=4
MAX_RETRIES=3
RETRY_DELAY=1s
MAX_QUEUE_LENGTH=100000
PUBLISH_CONCURRENCY=32
OPERATION_TIMEOUT=5s

# Explicit fault injection; keep both at zero during normal use.
PROCESSING_DELAY=0s
ACKNOWLEDGMENT_DELAY=0s
